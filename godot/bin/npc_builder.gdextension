[configuration]

entry_symbol = "npc_builder_library_init"
compatibility_minimum = "4.1"

[libraries]

linux.debug.x86_64 = "res://bin/libnpc_builder_extension.so"
linux.release.x86_64 = "res://bin/libnpc_builder_extension.so"
windows.debug.x86_64 = "res://bin/npc_builder_extension.dll"
windows.release.x86_64 = "res://bin/npc_builder_extension.dll"
macos.debug = "res://bin/libnpc_builder_extension.dylib"
macos.release = "res://bin/libnpc_builder_extension.dylib"
